<Window x:Class="Segmento.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Segmento"
        Height="850"
        Width="1280"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource DefaultFont}"
        FontSize="13"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                           CornerRadius="0"
                           GlassFrameThickness="0"
                           ResizeBorderThickness="6"
                           UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====================================================== -->
            <!-- SIDEBAR                                                 -->
            <!-- ====================================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Border Grid.Row="0" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Logo.png"
                                   Width="22" Height="22"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Segmento"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="NAWIGACJA"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="22,0,0,8"/>

                            <RadioButton x:Name="NavImport"
                                         Style="{StaticResource SidebarButton}"
                                         GroupName="MainNav"
                                         IsChecked="True"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Import PDF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSelect"
                                         Style="{StaticResource SidebarButton}"
                                         GroupName="MainNav"
                                         IsEnabled="False"
                                         Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE762;" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Wybór stron" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" x:Name="SelectBadge"
                                            Background="{DynamicResource SurfaceActiveBrush}"
                                            CornerRadius="10" Padding="6,1"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="SelectBadgeText" Text="0"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavOrganize"
                                         Style="{StaticResource SidebarButton}"
                                         GroupName="MainNav"
                                         IsEnabled="False"
                                         Checked="Nav_Checked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE71D;" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Organizuj" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" x:Name="OrganizeBadge"
                                            Background="{DynamicResource SurfaceActiveBrush}"
                                            CornerRadius="10" Padding="6,1"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="OrganizeBadgeText" Text="0"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"
                                    Margin="20,16,20,12"/>

                            <TextBlock Text="DZIAŁANIA"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="22,0,0,8"/>

                            <RadioButton x:Name="NavExport"
                                         Style="{StaticResource SidebarButton}"
                                         GroupName="MainNav"
                                         IsEnabled="False"
                                         Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Eksport" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                                <RadioButton x:Name="NavEditor"
                                             Style="{StaticResource SidebarButton}"
                                             GroupName="MainNav"
                                             IsEnabled="False"
                                             Checked="Nav_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED63;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edytor PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Padding="22,16"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="SEGMENTO"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <Button x:Name="LicenseBtn"
                                    Click="License_Click"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Margin="0,2,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="lic"
                                                   Text="v2.1 · Licencja i prawa autorskie"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="lic" Property="Foreground"
                                                        Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Setter TargetName="lic" Property="TextDecorations"
                                                        Value="Underline"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ====================================================== -->
            <!-- MAIN CONTENT                                            -->
            <!-- ====================================================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITLEBAR -->
                <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}"
                      MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock x:Name="HeaderTitle" Text="Witaj w Segmento"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderSubtitle" Text="Zacznij od importu plików PDF"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Window control buttons - ikony rysowane wektorowo (niezależne od fontu) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Minimalizuj: pozioma linia -->
                        <Button x:Name="MinimizeBtn"
                                Style="{StaticResource CaptionButton}"
                                Click="Minimize_Click"
                                ToolTip="Minimalizuj">
                            <Rectangle Width="11" Height="1"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <!-- Maksymalizuj: kwadrat (obrys) -->
                        <Button x:Name="MaximizeBtn"
                                Style="{StaticResource CaptionButton}"
                                Click="Maximize_Click"
                                ToolTip="Maksymalizuj">
                            <Grid Width="10" Height="10">
                                <Rectangle x:Name="MaxGlyph"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1"
                                           Fill="Transparent"/>
                            </Grid>
                        </Button>

                        <!-- Zamknij: krzyżyk X -->
                        <Button x:Name="CloseBtn"
                                Style="{StaticResource CloseCaptionButton}"
                                Click="Close_Click"
                                ToolTip="Zamknij">
                            <Grid Width="11" Height="11">
                                <Line X1="0" Y1="0" X2="11" Y2="11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1"/>
                                <Line X1="0" Y1="11" X2="11" Y2="0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- FILE INFO BAR -->
                <Border Grid.Row="1" x:Name="FileInfoBar"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="24,12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0">
                                <TextBlock Text="&#xEA90;" FontFamily="{StaticResource IconFont}"
                                           FontSize="18"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="FileNameText" Text="Brak plików"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="FileInfoText" Text=""
                                           FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="AddMoreBtn"
                                Style="{StaticResource SecondaryButton}"
                                Click="SelectFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dodaj PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- VIEWS -->
                <Grid Grid.Row="2">

                    <!-- IMPORT VIEW -->
                    <Grid x:Name="ImportView" Visibility="Visible">
                        <Border Padding="60" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border x:Name="DropZone"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="540" Height="400">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                            CornerRadius="20" Width="80" Height="80"
                                            HorizontalAlignment="Center" Margin="0,0,0,24">
                                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="36"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Przeciągnij pliki PDF tutaj"
                                               FontSize="22" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Możesz dodać wiele plików jednocześnie"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,8,0,28"/>
                                    <Button Style="{StaticResource PrimaryButton}"
                                                Click="SelectFile_Click"
                                                HorizontalAlignment="Center"
                                                Padding="28,12"
                                                Background="#1a1a1a"
                                                BorderBrush="#2e2e2e">
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#C43A00" Offset="0"/>
                                                        <GradientStop Color="#E85E00" Offset="0.4"/>
                                                        <GradientStop Color="#F07820" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </TextBlock.Foreground>
                                                Wybierz pliki
                                            </TextBlock>
                                        </Button>
                                    <TextBlock Text="Obsługiwany format: PDF"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,24,0,0"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- SELECT VIEW -->
                    <Grid x:Name="SelectView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="24,16"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectionCountText" Text="0 zaznaczonych"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Width="1" Height="14"
                                            Background="{DynamicResource BorderBrush}" Margin="14,0"/>
                                    <TextBlock Text="Prawy klik = podgląd HD"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Zaznacz wszystko" Style="{StaticResource GhostButton}"
                                                Click="SelectAll_Click" Margin="0,0,4,0"/>
                                        <Button Content="Usuń zaznaczenie" Style="{StaticResource GhostButton}"
                                                Click="DeselectAll_Click" Margin="0,0,12,0"/>
                                        <Button Content="Resetuj"
                                                Background="#c4c4c4"
                                                Foreground="#1a1a1a"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="ResetAndGoBack_Click"
                                                Margin="0,0,8,0"/>
                                        <Button x:Name="GoToOrganizeBtn"
                                                Content="Przejdź do organizacji"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="GoToOrganize_Click"
                                                IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="PagesScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="24,20,12,20"
                                          PreviewMouseLeftButtonDown="PagesArea_MouseDown"
                                          PreviewMouseMove="PagesArea_MouseMove"
                                          PreviewMouseLeftButtonUp="PagesArea_MouseUp">
                                <ItemsControl x:Name="PagesList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{Binding SelectionBorderBrush}"
                                                BorderThickness="2" CornerRadius="12"
                                                Background="{DynamicResource SurfaceElevatedBrush}"
                                                Margin="0,0,14,14" Padding="10" Width="190"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="PageTile_MouseLeftButtonDown"
                                                MouseRightButtonDown="PageTile_MouseRightButtonDown"
                                                Tag="{Binding}">
                                            <StackPanel>
                                                <Border Width="168" Height="210"
                                                        Background="White" CornerRadius="6"
                                                        Margin="0,0,0,10">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black" Direction="270"
                                                                          ShadowDepth="2" BlurRadius="8" Opacity="0.3"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="32" Foreground="#CCCCCC"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding LoadingVisibility}"/>
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding ThumbnailVisibility}"/>
                                                        <Border Background="#CC000000" CornerRadius="4"
                                                                Padding="6,2" Margin="6"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding SourceBadge}"
                                                                       FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Click="Checkbox_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Rubber band selection layer -->
                            <Canvas x:Name="RubberBandCanvas"
                                    Background="Transparent"
                                    IsHitTestVisible="False">
                                <Rectangle x:Name="RubberBandRect"
                                           Visibility="Collapsed"
                                           Fill="#330078D4"
                                           Stroke="#EDEDED"
                                           StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </Grid>

                    <!-- ORGANIZE VIEW -->
                    <Grid x:Name="OrganizeView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="24,16"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Organizuj kolejność stron"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Przeciągnij strony aby zmienić kolejność · Prawy klik = podgląd · ✕ = usuń"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Resetuj"
                                                Background="#c4c4c4"
                                                Foreground="#1a1a1a"
                                                Style="{StaticResource PrimaryButton}"
                                            Click="ResetAndGoBack_Click"
                                            Margin="0,0,8,0"/>
                                    <Button x:Name="ExportBtn"
                                            Content="Eksportuj do PDF"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="Export_Click"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="24,20,12,20">
                            <ItemsControl x:Name="OrganizeList" AllowDrop="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding OrganizeBorderBrush}"
                                                BorderThickness="2" CornerRadius="12"
                                                Background="{DynamicResource SurfaceElevatedBrush}"
                                                Margin="0,0,14,14" Padding="10" Width="190"
                                                Cursor="SizeAll" AllowDrop="True"
                                                PreviewMouseLeftButtonDown="OrganizeItem_MouseDown"
                                                MouseMove="OrganizeItem_MouseMove"
                                                MouseRightButtonDown="OrganizeItem_MouseRightButtonDown"
                                                DragEnter="OrganizeItem_DragEnter"
                                                DragLeave="OrganizeItem_DragLeave"
                                                DragOver="OrganizeItem_DragOver"
                                                Drop="OrganizeItem_Drop"
                                                Tag="{Binding}">
                                            <Grid>
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <Border Width="168" Height="210"
                                                                Background="White" CornerRadius="6">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="Black" Direction="270"
                                                                                  ShadowDepth="2" BlurRadius="8" Opacity="0.3"/>
                                                            </Border.Effect>
                                                            <Grid>
                                                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}"
                                                                           FontSize="32" Foreground="#CCCCCC"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding LoadingVisibility}"/>
                                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Visibility="{Binding ThumbnailVisibility}"/>
                                                                <Border Background="#CC000000" CornerRadius="4"
                                                                        Padding="6,2" Margin="6"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                                    <TextBlock Text="{Binding SourceBadge}"
                                                                               FontSize="9" FontWeight="SemiBold"
                                                                               Foreground="White"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Border Background="{DynamicResource AccentBrush}"
                                                                CornerRadius="6" Padding="8,3"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                Margin="8,8,0,0">
                                                            <TextBlock Text="{Binding OrganizeOrder}"
                                                                       Foreground="{DynamicResource OnAccentBrush}"
                                                                       FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Zielone kolko - ikona przeciagania -->
                                                        <Ellipse Grid.Column="1"
                                                                 Width="12" Height="12"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="Można przeciągać">
                                                            <Ellipse.Fill>
                                                                <SolidColorBrush Color="#2ECC71"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                </StackPanel>
                                                <!-- Przycisk usuwania - X rysowany wektorowo -->
                                                <Button Width="24" Height="24"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,8,8,0"
                                                        Background="{DynamicResource SurfaceActiveBrush}"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                                        BorderThickness="0" Cursor="Hand"
                                                        Click="RemoveFromOrganize_Click"
                                                        Tag="{Binding}"
                                                        ToolTip="Usuń stronę">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                                                    CornerRadius="12">
                                                                <Grid Width="9" Height="9">
                                                                    <Line X1="0" Y1="0" X2="9" Y2="9"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                          StrokeThickness="1.4"/>
                                                                    <Line X1="0" Y1="9" X2="9" Y2="0"
                                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                          StrokeThickness="1.4"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                <!-- EDITOR VIEW -->
                <Grid x:Name="EditorView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                
                    <!-- Toolbar narzędzi -->
                    <Border Grid.Row="0" Padding="24,12"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- Wybór strony -->
                                <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="EditorPageCombo" Width="150"
                                          Padding="10,6"
                                          Background="{DynamicResource SurfaceElevatedBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          BorderThickness="1"
                                          SelectionChanged="EditorPageCombo_SelectionChanged"/>
                                <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}"
                                        Margin="16,0"/>
                                <!-- Narzędzia -->
                                <RadioButton x:Name="ToolTextBtn" Content="Tekst"
                                             Style="{StaticResource SidebarButton}"
                                             GroupName="EditorTools"
                                             Click="Tool_Click" Tag="Text" Margin="0,0,4,0"/>
                                <RadioButton x:Name="ToolImageBtn" Content="Obraz"
                                             Style="{StaticResource SidebarButton}"
                                             GroupName="EditorTools"
                                             Click="Tool_Click" Tag="Image" Margin="0,0,4,0"/>
                                <RadioButton x:Name="ToolEraserBtn" Content="Gumka"
                                             Style="{StaticResource SidebarButton}"
                                             GroupName="EditorTools"
                                             Click="Tool_Click" Tag="Eraser" Margin="0,0,4,0"/>
                                <Button Content="Cofnij" Style="{StaticResource GhostButton}"
                                        Click="EditorUndo_Click" Margin="8,0,0,0"/>
                            </StackPanel>
                
                            <Button Grid.Column="1" Content="Resetuj"
                                                Background="#c4c4c4"
                                                Foreground="#1a1a1a"
                                                Style="{StaticResource PrimaryButton}"
                                    Click="ResetAndGoBack_Click"/>
                        </Grid>
                    </Border>
                
                    <!-- Obszar edycji -->
                    <ScrollViewer Grid.Row="1"
                                      x:Name="EditorScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource WindowBackgroundBrush}"
                                      PreviewMouseWheel="EditorScroll_PreviewMouseWheel">
                            <Grid x:Name="EditorCanvasGrid"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="32">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="EditorScale" ScaleX="1" ScaleY="1"/>
                                </Grid.LayoutTransform>
                                <Image x:Name="EditorPageImage"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Uniform"
                                       MaxWidth="900"/>
                                <InkCanvas x:Name="EditorInkCanvas"
                                           Background="Transparent"/>
                                <Canvas x:Name="EditorOverlayCanvas"
                                        Background="Transparent"
                                        MouseLeftButtonDown="EditorCanvas_MouseDown"/>
                            </Grid>
                        </ScrollViewer>
                </Grid>

                    <!-- Loading overlay -->
                    <Border x:Name="LoadingOverlay"
                            Background="{DynamicResource OverlayBrush}"
                            Visibility="Collapsed">
                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="16" Padding="32,28"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LoadingText" Text="Wczytywanie..."
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <ProgressBar IsIndeterminate="True" Width="200" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- STATUSBAR -->
                <Border Grid.Row="3"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                     Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" x:Name="StatusText" Text="Gotowy"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="StatusRight"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar Grid.Row="1" x:Name="ExportProgress"
                                     Margin="0,6,0,0" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
