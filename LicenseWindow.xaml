<Window x:Class="Segmento.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Licencja i prawa autorskie"
        Height="560"
        Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource DefaultFont}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                           CornerRadius="0"
                           GlassFrameThickness="0"
                           ResizeBorderThickness="0"
                           UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Licencja i prawa autorskie"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           shell:WindowChrome.IsHitTestVisibleInChrome="False"/>

                <Button Grid.Column="1"
                        Style="{StaticResource CloseCaptionButton}"
                        Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="11" Height="11">
                        <Line X1="0" Y1="0" X2="11" Y2="11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                        <Line X1="0" Y1="11" X2="11" Y2="0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,28">
                <StackPanel>
                    <!-- Logo + nazwa -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Logo.png"
                               Width="48" Height="48"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Segmento"
                                       FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Wersja 2.1"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"
                            Margin="0,24,0,20"/>

                    <!-- Opis -->
                    <TextBlock Text="Organizuj pliki PDF"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Prawa autorskie -->
                    <TextBlock Text="PRAWA AUTORSKIE"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18">
                        <Run Text="© 2026 Segmento. Wszelkie prawa zastrzeżone."/>
                        <LineBreak/>
                        <Run Text="Właściciel: Segmento Inc."/>
                    </TextBlock>

                    <!-- Licencja -->
                    <TextBlock Text="LICENCJA"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18">
                        <Run Text="Segmento jest autorskim oprogramowaniem przeznaczonym do użytku prywatnego, edukacyjnego oraz komercyjnego zgodnie z warunkami obowiązującej licencji."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Kopiowanie, modyfikowanie, rozpowszechnianie, odsprzedaż, dekompilacja, inżynieria wsteczna lub wykorzystywanie całości bądź części oprogramowania bez wyraźnej zgody właściciela praw autorskich jest zabronione."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Aplikacja wykorzystuje komponenty oraz biblioteki zewnętrzne, w tym między innymi:"/>
                        <LineBreak/>
                        <Run Text="• PDFsharp"/>
                        <LineBreak/>
                        <Run Text="• iText7"/>
                        <LineBreak/>
                        <Run Text="• SkiaSharp"/>
                        <LineBreak/>
                        <Run Text="• PDFtoImage"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Prawa do bibliotek zewnętrznych należą do ich właścicieli i podlegają odpowiednim licencjom open source."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Oprogramowanie dostarczane jest „tak jak jest”, bez jakiejkolwiek gwarancji wyrażonej lub dorozumianej, w tym gwarancji przydatności handlowej lub przydatności do określonego celu."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Autorzy oprogramowania nie ponoszą odpowiedzialności za jakiekolwiek szkody, utratę danych lub problemy wynikające z użytkowania aplikacji."/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="ESC = zamknij"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Zamknij"
                            Style="{StaticResource SecondaryButton}"
                            Padding="20,6"
                            Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
